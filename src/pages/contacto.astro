---
import { Image } from 'astro:assets';
import IconoChat from '../components/IconoChat.astro';
import Base from '../layouts/Base.astro';
import logo from '../assets/logo.png';
import { enlaceWhatsApp, sitio } from '../data/sitio';
---

<Base titulo="Contacto" descripcion="Escríbele a MAKK Creaciones por WhatsApp o Instagram. Estamos en Los Teques, Miranda.">
  <section class="contenedor grid gap-12 pt-10 md:grid-cols-[2fr_3fr] md:items-center">
    <Image src={logo} alt={`Logo de ${sitio.nombre}`} width={320} class="mx-auto w-48 md:w-full md:max-w-xs" />
    <div>
      <h1 class="text-4xl font-semibold">Contacto</h1>
      <p class="mt-3 text-lg text-tinta-suave">
        Somos {sitio.nombre}: fabricamos batas de baño hechas a mano en {sitio.ubicacion}, con envíos a toda Venezuela.
        {sitio.lema}.
      </p>

      <a href={enlaceWhatsApp('Hola MAKK, quiero información sobre las batas.')} class="boton-principal mt-8">
        <IconoChat class="size-4" />
        Escribir por WhatsApp
      </a>

      <dl class="mt-10 grid gap-6 text-sm sm:grid-cols-2">
        <div>
          <dt class="etiqueta">Teléfonos</dt>
          {
            sitio.telefonos.map((t) => (
              <dd class="mt-1">
                <a href={`tel:+58${t.replace(/\D/g, '').slice(1)}`} class="hover:text-verde-oscuro">
                  {t}
                </a>
              </dd>
            ))
          }
        </div>
        <div>
          <dt class="etiqueta">Instagram</dt>
          <dd class="mt-1">
            <a href={sitio.instagram} class="hover:text-verde-oscuro">{sitio.instagramUsuario}</a>
          </dd>
        </div>
        <div>
          <dt class="etiqueta">Ubicación</dt>
          <dd class="mt-1">{sitio.ubicacion}. Tienda virtual.</dd>
        </div>
        <div>
          <dt class="etiqueta">Envíos</dt>
          <dd class="mt-1">{sitio.envioLocal}. Resto del país por {sitio.enviosNacionales.join(', ')}.</dd>
        </div>
      </dl>
    </div>
  </section>
</Base>
