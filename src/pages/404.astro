---
import Base from '../layouts/Base.astro';
---

<Base titulo="Página no encontrada">
  <section class="contenedor py-24 text-center">
    <p class="etiqueta">Error 404</p>
    <h1 class="mt-3 text-4xl font-semibold">Esta página no existe</h1>
    <p class="mt-3 text-tinta-suave">Puede que el modelo ya no esté disponible.</p>
    <a href="/catalogo/" class="boton-principal mt-8">Ver el catálogo</a>
  </section>
</Base>
