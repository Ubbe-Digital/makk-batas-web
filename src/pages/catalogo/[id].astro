---
import type { GetStaticPaths } from 'astro';
import { getImage, Image } from 'astro:assets';
import { getEntry, render } from 'astro:content';
import IconoChat from '../../components/IconoChat.astro';
import ModeloCard from '../../components/ModeloCard.astro';
import Base from '../../layouts/Base.astro';
import { colores, getModelos, paraQuien, type Modelo } from '../../lib/catalogo';
import {
  enlaceCompartirWhatsApp,
  enlaceWhatsApp,
  mensajeCompartir,
  mensajeConsulta,
  sitio,
  tallas,
} from '../../data/sitio';

export const getStaticPaths = (async () => {
  const modelos = await getModelos();
  return modelos.map((modelo) => ({
    params: { id: modelo.id },
    props: { modelo, relacionados: modelos.filter((m) => m.data.categoria.id === modelo.data.categoria.id && m.id !== modelo.id) },
  }));
}) satisfies GetStaticPaths;

interface Props {
  modelo: Modelo;
  relacionados: Modelo[];
}

const { modelo, relacionados } = Astro.props;
const { Content } = await render(modelo);
const categoria = await getEntry(modelo.data.categoria);
const nombreCategoria = categoria?.data.nombre ?? '';
const url = new URL(`/catalogo/${modelo.id}/`, Astro.site).href;
const consulta = { nombre: modelo.data.nombre, url };
// El enlace va solo en la última línea para que WhatsApp arme la vista previa con la foto.
// WhatsApp no envía referente: el utm_source es la única forma de que Umami distinga las visitas
// que llegan por un enlace compartido. El enlace de la consulta (arriba) va a MAKK, no lleva utm.
const urlCompartida = `${url}?utm_source=whatsapp&utm_medium=compartir`;
// Enlace para pegar donde sea (Facebook, Instagram, un correo...). No sabemos adónde irá: el origen es
// "enlace"; en Umami la red sale del referente cuando la hay (Facebook lo envía; WhatsApp no).
const urlCopiada = `${url}?utm_source=enlace&utm_medium=compartir`;
const textoCompartir = mensajeCompartir({ nombre: modelo.data.nombre, colores: colores(modelo), url: urlCompartida });
const { fotos } = modelo.data;
// Versión a tamaño completo para el visor con zoom; la galería usa las reducidas.
const ampliadas = await Promise.all(fotos.map((foto) => getImage({ src: foto, format: 'webp', quality: 85 })));
---

<Base
  titulo={modelo.data.nombre}
  imagen={fotos[0]}
  imagenAlt={`Bata ${modelo.data.nombre}`}
  descripcion={`Bata ${modelo.data.nombre}: ${colores(modelo).toLowerCase()}. ${modelo.data.bordado}. Hecha a pedido por ${sitio.nombre}.`}>
  <div class="contenedor pt-6">
    <nav aria-label="Ruta" class="text-sm text-tinta-suave">
      <a href="/catalogo/" class="hover:text-verde-oscuro">Catálogo</a>
      <span aria-hidden="true"> / </span>
      <a href={`/catalogo/?categoria=${modelo.data.categoria.id}`} class="hover:text-verde-oscuro">{nombreCategoria}</a>
    </nav>

    <div class="mt-6 grid gap-10 lg:grid-cols-[3fr_2fr]">
      <div>
        <div class="relative">
        <ul id="galeria" class="flex snap-x snap-mandatory gap-3 overflow-x-auto rounded-2xl [scrollbar-width:none]">
          {
            fotos.map((foto, i) => (
              <li id={`foto-${i + 1}`} class="w-full shrink-0 snap-center">
                <a
                  href={ampliadas[i].src}
                  data-pswp-width={ampliadas[i].attributes.width}
                  data-pswp-height={ampliadas[i].attributes.height}
                  aria-label={`Ampliar foto ${i + 1} de ${fotos.length}`}
                  class="block cursor-zoom-in overflow-hidden rounded-2xl bg-arena">
                  <Image
                    src={foto}
                    alt={`Bata ${modelo.data.nombre}, foto ${i + 1} de ${fotos.length}`}
                    widths={[480, 720, 960, 1280]}
                    sizes="(min-width: 1024px) 60vw, 100vw"
                    class="aspect-[3/4] w-full object-contain"
                    loading={i === 0 ? 'eager' : 'lazy'}
                  />
                </a>
              </li>
            ))
          }
        </ul>
        {
          fotos.length > 1 &&
            [
              { sentido: -1, etiqueta: 'Foto anterior', lado: 'left-2', trazo: 'm15 18-6-6 6-6' },
              { sentido: 1, etiqueta: 'Foto siguiente', lado: 'right-2', trazo: 'm9 18 6-6-6-6' },
            ].map((f) => (
              <button
                type="button"
                data-flecha={f.sentido}
                aria-label={f.etiqueta}
                class={`absolute top-1/2 ${f.lado} z-10 flex size-9 -translate-y-1/2 items-center justify-center rounded-full bg-white/90 text-tinta shadow-md ring-1 ring-tinta/10 transition hover:bg-white disabled:pointer-events-none disabled:opacity-0 sm:size-10`}>
                <svg
                  class="size-5"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true">
                  <path d={f.trazo} />
                </svg>
              </button>
            ))
        }
        </div>
        {
          fotos.length > 1 && (
            <ul class="mt-3 flex gap-3" aria-label="Fotos">
              {fotos.map((foto, i) => (
                <li>
                  <a
                    href={`#foto-${i + 1}`}
                    data-miniatura
                    aria-current={i === 0 ? 'true' : undefined}
                    class="group block overflow-hidden rounded-lg ring-verde ring-offset-2 hover:ring-2 aria-[current=true]:ring-2">
                    <Image
                      src={foto}
                      alt={`Ver foto ${i + 1}`}
                      width={160}
                      class="size-16 object-cover opacity-60 transition-opacity group-hover:opacity-100 group-aria-[current=true]:opacity-100 sm:size-20"
                    />
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>

      <div>
        <p class="etiqueta">{nombreCategoria}</p>
        <h1 class="mt-2 text-4xl font-semibold">{modelo.data.nombre}</h1>
        <div class="mt-4 text-tinta-suave">
          <Content />
        </div>
        <div class="mt-5 flex flex-wrap gap-2">
          <a
            href={enlaceCompartirWhatsApp(textoCompartir)}
            class="boton-secundario py-2"
            data-evento="compartir-whatsapp"
            data-evento-modelo={modelo.data.nombre}>
            <svg
              class="size-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <circle cx="18" cy="5" r="3"></circle>
              <circle cx="6" cy="12" r="3"></circle>
              <circle cx="18" cy="19" r="3"></circle>
              <path d="m8.6 13.5 6.8 4M15.4 6.5l-6.8 4"></path>
            </svg>
            Compartir por WhatsApp
          </a>
          <button
            type="button"
            id="copiar-enlace"
            class="boton-secundario py-2"
            data-evento="copiar-enlace"
            data-evento-modelo={modelo.data.nombre}
            data-url={urlCopiada}>
            <svg
              class="size-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect x="9" y="9" width="13" height="13" rx="2"></rect>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
            </svg>
            <span data-texto>Copiar enlace</span>
          </button>
          <span class="sr-only" role="status" id="copiar-estado"></span>
        </div>

        <dl class="mt-6 divide-y divide-tinta/10 border-y border-tinta/10 text-sm">
          <div class="flex justify-between gap-4 py-3">
            <dt class="text-tinta-suave">Colores de la foto</dt>
            <dd class="text-right font-medium">{colores(modelo)}</dd>
          </div>
          <div class="flex justify-between gap-4 py-3">
            <dt class="text-tinta-suave">Para</dt>
            <dd class="text-right font-medium">{paraQuien(modelo)}</dd>
          </div>
          <div class="flex justify-between gap-4 py-3">
            <dt class="text-tinta-suave">Bordado</dt>
            <dd class="text-right font-medium">{modelo.data.bordado}</dd>
          </div>
          <div class="flex justify-between gap-4 py-3">
            <dt class="text-tinta-suave">Tallas</dt>
            <dd class="text-right font-medium">2 a XXXL</dd>
          </div>
          <div class="flex justify-between gap-4 py-3">
            <dt class="text-tinta-suave">Confección</dt>
            <dd class="text-right font-medium">{sitio.confeccion}</dd>
          </div>
        </dl>

        <form id="pedido" class="mt-8 space-y-4 rounded-2xl bg-arena/70 p-5" data-modelo={consulta.nombre} data-url={consulta.url}>
          <p class="font-display text-lg font-semibold">Personaliza tu pedido</p>
          <div class="grid gap-4 sm:grid-cols-2">
            <label class="block text-sm">
              <span class="font-medium">Talla</span>
              <select name="talla" class="mt-1 block w-full rounded-lg border border-tinta/15 bg-white px-3 py-2">
                <option value="">Aún no sé</option>
                {tallas.map((t) => <option>{t}</option>)}
              </select>
            </label>
            <label class="block text-sm">
              <span class="font-medium">Nombre a bordar</span>
              <input name="nombre" maxlength="30" class="mt-1 block w-full rounded-lg border border-tinta/15 bg-white px-3 py-2" />
            </label>
          </div>
          <label class="block text-sm">
            <span class="font-medium">Colores</span>
            <input
              name="colores"
              maxlength="60"
              placeholder="Como en la foto"
              class="mt-1 block w-full rounded-lg border border-tinta/15 bg-white px-3 py-2"
            />
          </label>
          <a
            id="enviar"
            href={enlaceWhatsApp(mensajeConsulta(consulta))}
            class="boton-principal w-full"
            data-evento="consultar-precio"
            data-evento-modelo={modelo.data.nombre}>
            <IconoChat class="size-4" />
            Consultar precio por WhatsApp
          </a>
          <p class="text-xs text-tinta-suave">El precio depende de la talla. Te respondemos por WhatsApp.</p>
        </form>
      </div>
    </div>
  </div>

  {
    relacionados.length > 0 && (
      <section class="contenedor pt-20">
        <h2 class="text-2xl font-semibold">Más de {nombreCategoria}</h2>
        <ul class="mt-6 grid grid-cols-2 gap-x-5 gap-y-10 lg:grid-cols-4">
          {relacionados.slice(0, 4).map((m) => (
            <ModeloCard modelo={m} categoria={nombreCategoria} />
          ))}
        </ul>
      </section>
    )
  }
</Base>

<script>
  import PhotoSwipeLightbox from 'photoswipe/lightbox';
  import 'photoswipe/style.css';
  import { enlaceWhatsApp, mensajeConsulta } from '../../data/sitio';

  // Arma el mensaje de WhatsApp con lo que el cliente va completando.
  const form = document.querySelector<HTMLFormElement>('#pedido')!;
  const enviar = document.querySelector<HTMLAnchorElement>('#enviar')!;

  function actualizar() {
    const datos = new FormData(form);
    const campo = (nombre: string) => String(datos.get(nombre) ?? '').trim();
    enviar.href = enlaceWhatsApp(
      mensajeConsulta(
        { nombre: form.dataset.modelo ?? '', url: form.dataset.url ?? '' },
        { talla: campo('talla'), colores: campo('colores'), bordado: campo('nombre') },
      ),
    );
  }

  // Copia el enlace del modelo (con utm) para pegarlo en Facebook u otra red.
  const copiar = document.querySelector<HTMLButtonElement>('#copiar-enlace')!;
  const copiarTexto = copiar.querySelector<HTMLElement>('[data-texto]')!;
  const copiarEstado = document.querySelector<HTMLElement>('#copiar-estado')!;
  let copiarTimer: ReturnType<typeof setTimeout>;

  async function escribirEnPortapapeles(texto: string) {
    try {
      await navigator.clipboard.writeText(texto);
      return true;
    } catch {
      // Sin permiso o contexto no seguro: respaldo con un campo oculto.
      const campo = document.createElement('textarea');
      campo.value = texto;
      campo.setAttribute('readonly', '');
      campo.style.position = 'fixed';
      campo.style.opacity = '0';
      document.body.append(campo);
      campo.select();
      const ok = document.execCommand('copy');
      campo.remove();
      return ok;
    }
  }

  copiar.addEventListener('click', async () => {
    const ok = await escribirEnPortapapeles(copiar.dataset.url ?? '');
    const mensaje = ok ? '¡Enlace copiado!' : 'No se pudo copiar';
    copiarTexto.textContent = mensaje;
    copiarEstado.textContent = mensaje;
    clearTimeout(copiarTimer);
    copiarTimer = setTimeout(() => {
      copiarTexto.textContent = 'Copiar enlace';
      copiarEstado.textContent = '';
    }, 2500);
  });

  form.addEventListener('input', actualizar);
  form.addEventListener('submit', (e) => e.preventDefault());

  const galeria = document.querySelector<HTMLElement>('#galeria')!;

  // Visor con zoom (pellizco, rueda, doble toque), arrastre y flechas.
  const visor = new PhotoSwipeLightbox({
    gallery: '#galeria',
    children: 'a[data-pswp-width]',
    pswpModule: () => import('photoswipe'),
    bgOpacity: 1,
    // Las fotos se muestran completas, no recortadas: la animacion de apertura
    // desde la miniatura no coincidiria con su encuadre.
    showHideAnimationType: 'fade',
    wheelToZoom: true,
    secondaryZoomLevel: 2,
    maxZoomLevel: 4,
    closeTitle: 'Cerrar',
    zoomTitle: 'Ampliar',
    arrowPrevTitle: 'Anterior',
    arrowNextTitle: 'Siguiente',
    errorMsg: 'No se pudo cargar la foto',
  });
  // Al cerrar, la galería queda en la foto que se estaba viendo.
  visor.on('close', () => {
    const actual = galeria.querySelectorAll<HTMLElement>(':scope > li')[visor.pswp?.currIndex ?? 0];
    if (actual) galeria.scrollTo({ left: actual.offsetLeft - galeria.offsetLeft });
  });
  visor.init();

  // La miniatura de la foto que se está viendo queda marcada.
  const miniaturas = [...document.querySelectorAll<HTMLAnchorElement>('[data-miniatura]')];
  const diapositivas = [...galeria.querySelectorAll<HTMLElement>(':scope > li')];
  const flechas = [...document.querySelectorAll<HTMLButtonElement>('[data-flecha]')];
  let vista = 0;
  // Las flechas se ocultan en la primera y en la última foto.
  function actualizarFlechas() {
    for (const f of flechas) f.disabled = vista + Number(f.dataset.flecha) < 0 || vista + Number(f.dataset.flecha) >= diapositivas.length;
  }
  for (const f of flechas) {
    f.addEventListener('click', () => {
      const destino = diapositivas[vista + Number(f.dataset.flecha)];
      if (destino) galeria.scrollTo({ left: destino.offsetLeft - galeria.offsetLeft, behavior: 'smooth' });
    });
  }
  actualizarFlechas();
  const marcar = new IntersectionObserver(
    (entradas) => {
      for (const e of entradas) {
        if (!e.isIntersecting) continue;
        const actual = diapositivas.indexOf(e.target as HTMLElement);
        vista = actual;
        actualizarFlechas();
        miniaturas.forEach((m, i) => (i === actual ? m.setAttribute('aria-current', 'true') : m.removeAttribute('aria-current')));
      }
    },
    { root: galeria, threshold: 0.6 },
  );
  diapositivas.forEach((d) => marcar.observe(d));

  // Las miniaturas desplazan la galería sin mover la página.
  for (const a of document.querySelectorAll<HTMLAnchorElement>('[data-miniatura]')) {
    a.addEventListener('click', (e) => {
      const destino = document.querySelector<HTMLElement>(a.hash);
      if (!destino) return;
      e.preventDefault();
      galeria.scrollTo({ left: destino.offsetLeft - galeria.offsetLeft, behavior: 'smooth' });
    });
  }
</script>
