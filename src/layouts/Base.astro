---
import '@fontsource-variable/fraunces';
import '@fontsource-variable/inter';
import frauncesUrl from '@fontsource-variable/fraunces/files/fraunces-latin-wght-normal.woff2?url';
import interUrl from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import '../styles/global.css';

import type { ImageMetadata } from 'astro';
import { getImage, Image } from 'astro:assets';
import IconoChat from '../components/IconoChat.astro';
import logo from '../assets/logo.png';
import { analitica, enlaceWhatsApp, sitio } from '../data/sitio';
import { version } from '../../package.json';

// Commit publicado: el CI lo da en GITHUB_SHA. Sirve para saber a simple vista
// si un cambio ya se desplegó (la versión de package.json solo cambia a mano).
const commit = process.env.GITHUB_SHA?.slice(0, 7) ?? 'dev';
const build = `v${version} · ${commit}`;

interface Props {
  titulo?: string;
  descripcion?: string;
  // Vista previa al compartir el enlace (WhatsApp, Instagram, Facebook).
  imagen?: ImageMetadata;
  imagenAlt?: string;
}

const { titulo, descripcion = sitio.descripcion, imagen, imagenAlt } = Astro.props;
const tituloCompleto = titulo ? `${titulo} · ${sitio.nombre}` : `${sitio.nombre} · Batas de baño hechas a mano`;
const ruta = Astro.url.pathname;
const url = new URL(ruta, Astro.site);

// JPEG y sin recortar: WhatsApp no siempre muestra WebP, y un recorte
// horizontal de una foto vertical deja fuera el bordado.
const vistaPrevia = imagen
  ? await getImage({ src: imagen, width: 600, format: 'jpg', quality: 78 })
  : await getImage({ src: logo, width: 600, format: 'png' });
const vistaPreviaAlt = imagen ? (imagenAlt ?? tituloCompleto) : `Logo de ${sitio.nombre}`;

const enlaces = [
  { href: '/catalogo/', texto: 'Catálogo' },
  { href: '/bordados/', texto: 'Bordados' },
  { href: '/como-pedir/', texto: 'Cómo pedir' },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Se precargan para que el texto no cambie de tipografía (y de alto) después de pintar. */}
    <link rel="preload" as="font" type="font/woff2" href={frauncesUrl} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={interUrl} crossorigin />
    <meta name="app-version" content={build} />
    <meta name="generator" content={Astro.generator} />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={url} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#15966f" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_VE" />
    <meta property="og:site_name" content={sitio.nombre} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={new URL(vistaPrevia.src, Astro.site)} />
    <meta property="og:image:type" content={imagen ? 'image/jpeg' : 'image/png'} />
    <meta property="og:image:width" content={String(vistaPrevia.attributes.width)} />
    <meta property="og:image:height" content={String(vistaPrevia.attributes.height)} />
    <meta property="og:image:alt" content={vistaPreviaAlt} />
    <meta name="twitter:card" content={imagen ? 'summary_large_image' : 'summary'} />
    {
      analitica.scriptUrl && analitica.websiteId && (
        // Solo mide el dominio publicado (no localhost ni vistas previas) y respeta "No rastrear".
        <script
          defer
          src={analitica.scriptUrl}
          data-website-id={analitica.websiteId}
          data-domains={Astro.site?.hostname}
          data-do-not-track="true"
        />
      )
    }
  </head>
  <body class="flex min-h-dvh flex-col">
    <header class="sticky top-0 z-30 border-b border-tinta/10 bg-papel/90 backdrop-blur">
      <div class="contenedor flex h-16 items-center justify-between gap-4">
        <a href="/" class="flex items-center gap-3" aria-label={`${sitio.nombre}, inicio`}>
          <Image src={logo} alt="" width={40} height={40} densities={[1.5, 2, 3]} class="size-10" loading="eager" />
          <span class="font-display text-xl font-semibold tracking-tight">MAKK</span>
        </a>
        <nav aria-label="Principal" class="hidden md:block">
          <ul class="flex items-center gap-1 text-sm font-medium">
            {
              enlaces.map((e) => (
                <li>
                  <a
                    href={e.href}
                    class:list={[
                      'rounded-full px-4 py-2 transition-colors hover:bg-arena',
                      ruta.startsWith(e.href) && 'bg-arena text-verde-oscuro',
                    ]}
                    aria-current={ruta.startsWith(e.href) ? 'page' : undefined}
                  >
                    {e.texto}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <a
          href={enlaceWhatsApp('Hola MAKK, quiero información sobre las batas.')}
          class="boton-principal hidden py-2 sm:inline-flex"
          data-evento="whatsapp"
          data-evento-origen="cabecera">
          <IconoChat class="size-4" />
          WhatsApp
        </a>
      </div>
      <nav aria-label="Principal" class="border-t border-tinta/10 md:hidden">
        <ul class="contenedor flex justify-between text-sm font-medium">
          {
            enlaces.map((e) => (
              <li>
                <a
                  href={e.href}
                  class:list={['block px-1 py-3', ruta.startsWith(e.href) && 'text-verde-oscuro underline underline-offset-8']}
                  aria-current={ruta.startsWith(e.href) ? 'page' : undefined}
                >
                  {e.texto}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="mt-24 bg-tinta text-papel/80">
      <div class="contenedor grid gap-10 py-14 sm:grid-cols-2">
        <div>
          <p class="font-display text-2xl text-papel">{sitio.nombre}</p>
          <p class="mt-2 text-sm">{sitio.lema}. Batas hechas a mano en {sitio.ubicacion}.</p>
        </div>
        <div class="text-sm">
          <p class="font-semibold text-papel">Contacto</p>
          <ul class="mt-3 space-y-2">
            {
              sitio.telefonos.map((t) => (
                <li>
                  <a href={`tel:+58${t.replace(/\D/g, '').slice(1)}`} class="hover:text-crema">
                    {t}
                  </a>
                </li>
              ))
            }
            <li>
              <a href={sitio.instagram} class="hover:text-crema">Instagram {sitio.instagramUsuario}</a>
            </li>
            <li>
              <a href="/como-pedir/" class="hover:text-crema">Tallas, pagos y envíos</a>
            </li>
          </ul>
        </div>
      </div>
      <p class="contenedor border-t border-papel/10 py-6 text-xs text-papel/50">
        © {new Date().getFullYear()} {sitio.nombre}
        {
          analitica.scriptUrl && analitica.websiteId && (
            <span> · Medimos las visitas y los clics de forma anónima y sin cookies.</span>
          )
        }
        <span class="ml-2 whitespace-nowrap" data-build>{build}</span>
      </p>
    </footer>

    <a
      href={enlaceWhatsApp('Hola MAKK, quiero información sobre las batas.')}
      data-evento="whatsapp"
      data-evento-origen="flotante"
      class="fixed right-4 bottom-4 z-40 flex size-14 items-center justify-center rounded-full bg-verde text-white shadow-lg shadow-tinta/20 transition-colors hover:bg-verde-oscuro sm:hidden"
      aria-label="Escribir por WhatsApp"
    >
      <IconoChat class="size-6" />
    </a>
    <script>
      // Eventos de Umami en los enlaces (data-evento y data-evento-*). NO se usa
      // data-umami-event en enlaces: con él, el rastreador hace preventDefault y
      // navega solo cuando termina su petición de red; con una red lenta el botón
      // parece muerto y la gente hace clic varias veces (varios eventos). Aquí el
      // evento se envía sin esperar (Umami usa keepalive) y el enlace navega ya.
      const ESPERA_MS = 4000;
      document.addEventListener('click', (e) => {
        const el = (e.target as Element).closest<HTMLElement>('[data-evento]');
        if (!el) return;
        // Segundo clic mientras WhatsApp todavía se está abriendo: se ignora.
        if (el.getAttribute('aria-busy') === 'true') {
          e.preventDefault();
          return;
        }
        const datos: Record<string, string> = {};
        for (const [clave, valor] of Object.entries(el.dataset)) {
          if (clave.startsWith('evento') && clave !== 'evento') datos[clave.slice(6).toLowerCase()] = valor ?? '';
        }
        (window as unknown as { umami?: { track: (nombre: string, datos?: object) => void } }).umami?.track(el.dataset.evento!, datos);
        // Señal de que el clic funcionó (en escritorio WhatsApp tarda en abrir).
        if (el.tagName === 'A' && !(e.ctrlKey || e.metaKey || e.shiftKey)) {
          el.setAttribute('aria-busy', 'true');
          setTimeout(() => el.removeAttribute('aria-busy'), ESPERA_MS);
        }
      });
    </script>
  </body>
</html>
